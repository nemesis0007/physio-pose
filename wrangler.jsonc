{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "physiotwin-patient",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-26",
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
